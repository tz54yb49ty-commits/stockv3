.DS_Store
__pycache__/
*.py[cod]
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
.env
.env.*
.coverage
htmlcov/
build/
dist/

# Local runtime/test artifacts and generated outputs.
tmp/
outputs/
backups/
repomix-output.xml
*.log
*.pid

# Large runtime data belongs under /Volumes/MacRaid/database.
data_lake/*
!data_lake/.gitkeep

# Generated gate/runtime artifacts. Keep canonical Markdown docs separately.
docs/**/*.json
docs/**/*.jsonl
docs/**/*.csv
docs/**/*.parquet
docs/**/*.xlsx
docs/**/*.xls
docs/intraday_live_current/
docs/runtime/
docs/runtime_archive/
docs/post_close_fastlane/
docs/replay/

# Root-level ad-hoc data exports.
/*.csv
/*.parquet
/*.xlsx
/*.xls

# Patch artifacts are local handoff material, not source.
*.patch
/gpcw*.zip
