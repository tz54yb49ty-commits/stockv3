  "component": {
    "name": "N3N6Q",
    "transport": "in_process_synchronous_facade",
    "stateful": false,
    "public_http_route": false,
    "long_running_process": false,
    "exclusive_consumer": "N6_virtual_account_internal_one_shot"
  },
  "quote_identity_v1": {
    "collection_type": "array",
    "min_items": 1,
    "max_items": 80,
    "item_fields": [
      "identity_key",
      "exchange",
      "stock_code"
    ],
    "additional_properties": false,
    "field_contract": {
      "identity_key": {
        "type": "string",
        "pattern": "^stock:(SH|SZ|BJ):[0-9]{6}$"
      },
      "exchange": {
        "type": "string",
        "enum": [
          "SH",
          "SZ",
          "BJ"
        ]
      },
      "stock_code": {
        "type": "string",
        "pattern": "^[0-9]{6}$"
      }
    },
    "unique_by": "identity_key",
    "identity_fields_must_agree": true
  },
  "quote_batch_v1": {
    "exact_fields": [
      "contract_version",
      "batch_id",
      "source_adapter",
      "source_version",
      "source_time_semantics",
      "requested_at",
      "completed_at",
      "batch_status",
      "item_count",
      "items"
    ],
    "additional_properties": false,
    "fixed_values": {
      "contract_version": "1.0.0",
      "source_adapter": "mootdx.std",
      "source_time_semantics": "provider_intraday_time_without_trade_date"
    },
    "batch_status_enum": [
      "passed",
      "partial",
      "failed"
    ],
    "item_count_equals_request_count": true,
    "items_preserve_request_order": true,
    "quote_item": {
      "exact_fields": [
        "identity_key",
        "exchange",
        "market",
        "stock_code",
        "current_price",
        "last_close",
        "day_open",
        "day_high",
        "day_low",
        "source_time_text",
        "fetched_at",
        "quality_status",
        "quality_reason"
      ],
      "additional_properties": false,
      "field_types": {
        "identity_key": "string",
        "exchange": "SH|SZ|BJ",
        "market": "integer|null",
        "stock_code": "six_digit_string",
        "current_price": "decimal_string|null",
        "last_close": "decimal_string|null",
        "day_open": "decimal_string|null",
        "day_high": "decimal_string|null",
        "day_low": "decimal_string|null",
        "source_time_text": "string|null",
        "fetched_at": "timezone_aware_iso8601",
        "quality_status": "passed|not_ready",
        "quality_reason": "quality_reason_enum"
      },
      "quality_status_enum": [
        "passed",
        "not_ready"
      ],
      "quality_reason_enum": [
        "ok",
        "missing",
        "identity_mismatch",
        "invalid_price",
        "invalid_source_time",
        "provider_error",
        "unsupported_exchange"
      ],
      "decimal_encoding": "base10_fixed_point_string",
      "raw_provider_payload_allowed": false
    }
  },
