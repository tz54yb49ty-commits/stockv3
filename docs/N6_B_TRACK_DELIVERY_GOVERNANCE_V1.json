  "policy_lifecycle": {
    "new_one_off_policy_for_normal_n6_delivery_allowed": false,
    "legacy_named_policies": "append_only_compatibility",
    "legacy_policy_removal": "separate_retirement_gate_only",
    "new_requests": "must_classify_into_L1_L2_L3_or_REJECT"
  },
  "worktree_governance": {
    "canonical_branch": "codex/n6-btrack-integration",
    "canonical_worktree": "/Users/chuanfuchen/Documents/A股监控系统v3_n6_btrack_integration",
    "managed_active_limit": 5,
    "managed_roles": [
      "integration",
      "current_development",
      "current_governance",
      "emergency_fix",
      "acceptance"
    ],
    "cleanup_requires": [
      "clean_index",
      "clean_tracked_worktree",
      "zero_untracked_files",
      "zero_ignored_artifacts",
      "commit_and_rollback_evidence_frozen"
    ],
    "automatic_delete_allowed": false
  },
  "release_governance": {
    "default_service_set": [
      "web",
      "quote_writer",
      "virtual_executor",
      "stop_loss"
    ],
    "single_commit_default": true,
    "divergence_requires_compatibility_registration": true,
    "database_state_must_be_recorded": true,
    "immutable_release_required": true
  }
